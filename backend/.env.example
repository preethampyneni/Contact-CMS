# ===================================================
# C++ BACKEND ENVIRONMENT CONFIGURATION (.env)
# ===================================================

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Firebase Firestore REST API Configuration
# Replace these with your actual Firebase project settings
FIREBASE_PROJECT_ID=group11-contact-system
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_DATABASE_URL=https://firestore.googleapis.com/v1/projects/group11-contact-system/databases/(default)/documents

# Fallback / Local Storage Mode (enabled if Firebase credentials are omitted or offline)
USE_LOCAL_STORAGE_FALLBACK=true
